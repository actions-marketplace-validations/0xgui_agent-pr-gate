{
  "name": "agent-pr-gate",
  "version": "1.0.3",
  "private": true,
  "description": "GitHub Action that gates agent-written PRs before human review: risk tiers, required evidence, reviewer routing.",
  "main": "dist/index.js",
  "bin": {
    "agent-pr-gate": "dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --legal-comments=none --outfile=dist/index.js && esbuild src/bin.ts --bundle --platform=node --target=node24 --format=cjs --legal-comments=none --banner:js='#!/usr/bin/env node' --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "all": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "minimatch": "^10.2.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  }
}
